# === Telegram ===
# Токен бота от @BotFather
BOT_TOKEN=

# === Google Sheets ===
# ID таблицы (из ссылки между /d/ и /edit)
SPREADSHEET_ID=
# Путь к JSON-ключу сервисного аккаунта Google
GOOGLE_CREDENTIALS_FILE=service_account.json

# === Доступ ===
# Telegram ID администраторов через запятую (можно оставить пустым,
# тогда первый вошедший получит свой ID в сообщении об отказе)
ADMIN_IDS=

# === Общие настройки ===
TIMEZONE=Asia/Almaty
DEFAULT_DIGEST_TIME=09:00
